# Both environments are read-only. Use base-mainnet or base-sepolia.
EPEIUS_ENVIRONMENT=base-sepolia
# Public endpoints are rate-limited. Replace with your provider URL if needed.
EPEIUS_RPC_URL=https://sepolia.base.org
# Base mainnet: https://mainnet.base.org
EPEIUS_LISTEN_ADDR=127.0.0.1:8080
EPEIUS_ENGINE_URL=http://127.0.0.1:8080
